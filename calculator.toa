TOA 1.0

[APP]
id=calculator
name=Hesap Makinesi
version=1.0.0
author=TerminalOS
description=Basit TerminalOS hesap makinesi
icon=⌗
entry=main

[CODE]
main:
LABEL text="Hesap Makinesi"
LABEL text="Dört işlem ve yüzde hesaplama"

INPUT id=display placeholder="İşlem gir..."

BUTTON id=seven text="7"
BUTTON id=eight text="8"
BUTTON id=nine text="9"
BUTTON id=divide text="/"

BUTTON id=four text="4"
BUTTON id=five text="5"
BUTTON id=six text="6"
BUTTON id=multiply text="*"

BUTTON id=one text="1"
BUTTON id=two text="2"
BUTTON id=three text="3"
BUTTON id=subtract text="-"

BUTTON id=zero text="0"
BUTTON id=dot text="."
BUTTON id=equals text="="
BUTTON id=plus text="+"

BUTTON id=clear text="C"
BUTTON id=percent text="%"

ON seven:
SET key=display value=7

ON eight:
SET key=display value=8

ON nine:
SET key=display value=9

ON divide:
SET key=display value=/

ON four:
SET key=display value=4

ON five:
SET key=display value=5

ON six:
SET key=display value=6

ON multiply:
SET key=display value=*

ON one:
SET key=display value=1

ON two:
SET key=display value=2

ON three:
SET key=display value=3

ON subtract:
SET key=display value=-

ON zero:
SET key=display value=0

ON dot:
SET key=display value=.

ON plus:
SET key=display value=+

ON clear:
MESSAGE title=Hesap Makinesi text=Temizlendi

ON percent:
MESSAGE title=Hesap Makinesi text=Yüzde

ON equals:
MESSAGE title=Hesap Makinesi text=Hesaplama yapıldı

END
