TOA 2.0

[APP]
id=browser
name=TerminalOS Browser
version=1.0.0
author=TerminalOS
description=TerminalOS için web tarayıcısı
icon=🌐
entry=main

[DATA]
homepage=https://www.google.com
useragent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.8027.0 Safari/537.36

[FRONTEND]
WINDOW title="TerminalOS Browser" width=1200 height=750

LABEL id=title text="TerminalOS Browser"

INPUT id=url placeholder="Adres gir..."

BUTTON id=back text="←"
BUTTON id=forward text="→"
BUTTON id=reload text="⟳"
BUTTON id=go text="Git"

BROWSER id=web homepage="$homepage" useragent="$useragent"

[EVENTS]

back:
BACK target=web

forward:
FORWARD target=web

reload:
RELOAD target=web

go:
NAVIGATE target=web url=$url

[BACKEND]

SET key=current_url value=$homepage
